# ═══════════════════════════════════════════════════════════
#  ATMOS ARB BOT — Configuração da Wallet
#  Copia este ficheiro para .env e preenche os valores
# ═══════════════════════════════════════════════════════════

# Chave privada da wallet (hex, com ou sem 0x)
# NUNCA partilhes este valor com ninguém!
PRIVATE_KEY=0xTUA_CHAVE_PRIVADA_AQUI

# Endereço público da wallet (formato 0x...)
SENDER_ADDRESS=0xTEU_ENDERECO_PUBLICO_AQUI

# ── Telegram (opcional) ─────────────────────────────────────
# Para receber notificações de trades executados
# 1. Cria um bot em @BotFather no Telegram → obtém o token
# 2. Envia uma mensagem ao bot → obtém o chat_id em https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
